APP_NAME="Aula Virtual API Servicios"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://api-nginx
APP_TIMEZONE=America/Lima

LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_SLOW_QUERY_MS=250
PERF_LOG_SLOW_MS=800
PERF_LOG_SAMPLE_RATE=0.05

INTERNAL_SERVICE_TOKEN=CAMBIAR_POR_TOKEN_LARGO_SEGURO

DB_CONNECTION=mysql_cursos
# Base academica de Aula Virtual.
# Produccion: u937232440_sd_core
# Dev/staging: u937232440_sd_core_dev_2
# Test: u937232440_sd_core_test_2
# Historico: u937232440_sd_core_historico solo lectura, no usar como DB normal.
#
# Importante: las migraciones del API solo apuntan a mysql_cursos.
# No ejecutar migraciones sobre WordPress (u937232440_WPVF9).
#
# Si el stack no comparte red con wp-mysql, usa el puerto publicado del MySQL del VPS:
# DB_CURSOS_HOST=host.docker.internal
# DB_CURSOS_PORT=3307
#
# Si conectas este stack a la misma red Docker de WordPress/MySQL, puedes usar:
# DB_CURSOS_HOST=wp-mysql
# DB_CURSOS_PORT=3306
DB_CURSOS_HOST=host.docker.internal
DB_CURSOS_PORT=3307
DB_CURSOS_DATABASE=u937232440_sd_core
DB_CURSOS_USERNAME=aula_core_user
DB_CURSOS_PASSWORD=CAMBIAR_PASSWORD_CORE

DB_SGA_HOST=${DB_CURSOS_HOST}
DB_SGA_PORT=${DB_CURSOS_PORT}
DB_SGA_DATABASE=${DB_CURSOS_DATABASE}
DB_SGA_USERNAME=${DB_CURSOS_USERNAME}
DB_SGA_PASSWORD=${DB_CURSOS_PASSWORD}
SGA_PUBLIC_BASE_URL=https://sga.tudominio.com
CERTIFICADO_PUBLIC_BASE_URL=https://aula.tudominio.com
ENVIO_CERTIFICADOS_CORREO_PRUEBAS=

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

GOOGLE_DRIVE_LMS_FOLDER_ID=

MEETINGS_INTEGRATION_ENABLED=true
ATTENDANCE_ENABLED=false
ATTENDANCE_ZOOM_SYNC_ENABLED=false
ZOOM_ACCOUNT_ID=
ZOOM_SERVER_CLIENT_ID=
ZOOM_SERVER_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=

EVALUACION_TRABAJO_MAX_ARCHIVOS=5
EVALUACION_TRABAJO_MAX_FILE_SIZE_MB=50
EVALUACION_TRABAJO_ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,zip,rar,jpg,jpeg,png,txt,csv,odt,ods,odp,json,yml,yaml
