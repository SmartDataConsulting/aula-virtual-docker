# Variables leidas por Docker Compose antes de crear contenedores.
# Copiar como .env.deploy en /opt/aula-virtual.
AULA_DOMAIN=aula.tudominio.com

# Produccion con Nginx instalado en el host:
# Nginx publico -> http://127.0.0.1:8010 -> portal-nginx container.
PORTAL_HTTP_PORT=127.0.0.1:8010

# Para Portainer + Nginx Proxy Manager usando IP del VPS, puedes cambiarlo a:
# PORTAL_HTTP_PORT=8010
PORTAL_ENV_FILE=.env.portal.example
API_ENV_FILE=.env.api.example
AULA_SECRETS_DIR=./secrets
