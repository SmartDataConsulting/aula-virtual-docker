FROM node:22-alpine AS assets

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY resources ./resources
COPY public ./public
COPY vite.config.js ./
RUN npm run build

FROM nginx:1.27-alpine

WORKDIR /var/www

COPY public ./public
COPY --from=assets /app/public/build ./public/build
COPY docker/nginx/portal.prod.conf /etc/nginx/conf.d/default.conf
